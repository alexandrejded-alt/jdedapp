# Copie ce fichier en ".env.local" (même dossier) et remplace les deux valeurs.
# Tu les trouves dans Supabase : Project Settings > API.

# "Project URL" (ressemble à https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co

# Clé "anon public" (une longue suite de caractères). Ce n'est pas un secret,
# mais n'utilise JAMAIS la clé "service_role" ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-ici
